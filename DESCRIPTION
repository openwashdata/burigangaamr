Package: burigangaamr
Title: Antibiotic Resistance of P. aeruginosa from the Buriganga River
Version: 0.0.0.9000
Authors@R: c(
    person("Lars", "Schöbitz", , "lschoebitz@ethz.ch", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0003-2196-5015")),
